      "referenceSolution": "def solve(capacity, operations):\n    cache = {}  # dict keeps insertion order: the first key is the least recently used\n    results = []\n    for op in operations:\n        if op[0] == 'put':\n            _, key, value = op\n            if key in cache:\n                del cache[key]\n            elif len(cache) >= capacity:\n                del cache[next(iter(cache))]\n            cache[key] = value\n        else:\n            key = op[1]\n            if key in cache:\n                cache[key] = cache.pop(key)\n                results.append(cache[key])\n            else:\n                results.append(-1)\n    return results\n"
