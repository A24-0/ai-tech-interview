      "title": "Сумма пар",
      "statement": "Дан список целых чисел `nums` и число `k`. Верните `True`, если в списке есть два элемента **с разными индексами**, сумма которых равна `k`, иначе `False`.\n\nОдин и тот же элемент нельзя использовать дважды.\n\n**Пример 1**\n\nВход: `nums = [1, 2, 3]`, `k = 4`\n\nВыход: `True` (1 + 3 = 4)\n\n**Пример 2**\n\nВход: `nums = [2]`, `k = 4`\n\nВыход: `False`",
      "entry": "solve",
      "starterCode": "def solve(nums, k):\n    pass\n",
      "tests": [
        {
          "name": "пример",
          "args": [
            [
              1,
              2,
              3
            ],
            4
          ],
          "expected": true
        },
        {
          "name": "пустой список",
          "args": [
            [],
            1
          ],
          "expected": false
        },
        {
          "name": "один элемент не складывается сам с собой",
          "args": [
            [
              2
            ],
            4
          ],
          "expected": false
        },
        {
          "name": "два одинаковых числа",
          "args": [
            [
              2,
              2
            ],
            4
          ],
          "expected": true
        },
        {
          "name": "отрицательные числа",
          "args": [
            [
              -3,
              7,
              1,
              10
            ],
            4
          ],
          "expected": true
        },
        {
          "name": "пары нет",
          "args": [
            [
              1,
              5,
              9
            ],
            3
          ],
          "expected": false
        },
        {
          "name": "большие числа",
          "args": [
            [
              1000000000000000000,
              1,
              999999999999999999
            ],
            1999999999999999999
          ],
          "expected": true
        },
        {
          "name": "нули",
          "assert": "assert solve([0, 0], 0) is True"
        }
      ],
      "limits": {
        "perTestTimeoutMs": 2000,
        "maxOutputBytes": 65536
      },
      "referenceSolution": "def solve(nums, k):\n    seen = set()\n    for x in nums:\n        if k - x in seen:\n            return True\n        seen.add(x)\n    return False\n"
