#
# Sandbox image: docker build -f sandbox/Dockerfile.runner -t interview-sandbox:latest sandbox
# Runtime limits (network, memory, pids, read-only rootfs, tmpfs /tmp) are set by DockerSandbox.
FROM python:3.12-slim

COPY runner.py /runner/runner.py

USER 65534:65534
WORKDIR /tmp

ENTRYPOINT ["python", "-I", "/runner/runner.py"]
