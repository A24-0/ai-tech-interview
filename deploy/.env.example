# Copy to deploy/.env and fill in. Secrets are never committed.

POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=interview
DATABASE_URL=postgresql+asyncpg://app:<POSTGRES_PASSWORD>@postgres:5432/interview

JWT_SECRET=
ADMIN_TOKENS=                         # токены администраторов через запятую (пока вместо ролей)
WEB_PORT=8080

LLM_PROVIDER=openai_compatible        # или fake
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=2
SESSION_TOKEN_LIMIT=40000

SANDBOX_BACKEND=docker               # docker | subprocess | fake
SANDBOX_IMAGE=interview-sandbox:latest
SANDBOX_TIMEOUT_S=5
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=1
SANDBOX_PIDS=64

WORKER_CONCURRENCY=2
WORKER_POLL_MS=500
WORKER_STALE_AFTER_S=60              # running дольше -> обратно в очередь (воркер умер)
WORKER_MAX_ATTEMPTS=3
WORKER_REVIEW_TIMEOUT_S=60           # разбор дольше -> запуск остаётся done без aiReview
RUNS_PER_TASK_LIMIT=20

# DOCKER_HOST задаётся в docker-compose.yml: tcp://docker-socket-proxy:2375
